// ----------------------------------------------------------------
// 📋 Prisma 7 Schema for Circular Tracker
// ----------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // URL is managed via prisma.config.ts
}

// ─── Enums ───────────────────────────────────────────────────────

enum ItemStatus {
  ACTIVE
  STALE
  DONATED
  RECYCLED
}

enum Category {
  TEXTILE
  WOOD
  METAL
  PLASTIC
  GLASS
  OTHER
}

// ─── Models ──────────────────────────────────────────────────────

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  businessName String
  createdAt    DateTime        @default(now())
  items        InventoryItem[]

  @@map("users")
}

model InventoryItem {
  id             String     @id @default(uuid())
  name           String
  category       Category   @default(OTHER)
  weight         Float
  barcode        String?    @unique
  imageUrl       String?

  addedAt        DateTime   @default(now())
  lastAccessedAt DateTime   @default(now())

  riskLevel      Float      @default(0.0)
  status         ItemStatus @default(ACTIVE)

  // Each item belongs to a business (User)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}
