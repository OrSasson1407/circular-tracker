{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "paths": {
      "@circular/shared": ["../shared/index.ts"]
    },
    // The Fix: Explicitly tell TS the root is the parent folder
    "rootDir": "..", 
    "outDir": "./dist",
    "composite": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts", 
    "prisma.config.ts", 
    "../shared/**/*.ts"
  ],
  "exclude": ["node_modules"]
}